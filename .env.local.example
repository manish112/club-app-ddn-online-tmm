NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_ADMIN_PASSWORD=your-admin-password-here
# Server-side only (has write access, never ship to the client). Used by the
# import script AND all email/notification routes (they read SMTP settings from
# the DB via the service role, which bypasses RLS on the email_* tables).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Shared secret guarding the cron endpoints (/api/auto-schedule, /api/notify-reminders).
# Vercel Cron auto-sends "Authorization: Bearer $CRON_SECRET" when this is set.
CRON_SECRET=your-cron-secret-here
# Public base URL used in email links (defaults to https://ddn.toastmasters.in).
NEXT_PUBLIC_APP_URL=https://ddn.toastmasters.in

# WhatsApp delivery callbacks (/api/whatsapp-webhook). Meta reports delivered /
# read / failed only over this webhook — without it the message log can say a
# message was accepted, never that it arrived.
#   VERIFY_TOKEN: any string you choose; paste the same one into Meta App
#     Dashboard → WhatsApp → Configuration → Webhook when setting the callback URL.
#   APP_SECRET:   Meta App Dashboard → App settings → Basic → App secret. Every
#     callback is signed with it, and unsigned ones are rejected.
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose
WHATSAPP_APP_SECRET=your-meta-app-secret

# NOTE: SMTP connection (host/port/user/pass/from) and all email templates are
# configured from the admin panel (Email tab), stored in the DB — not here.
